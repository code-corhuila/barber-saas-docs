# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Environment variables for local development
#
# Framework example. BarberSaaS's real variables live in barber-saas-infra/env/.env.<environment>.example
# (05-architecture/deployment.md §6).
#
# USAGE: cp .env.example .env
#        Then edit .env with your local values.
#
# NEVER: commit the .env file with real values.
#        Real dev/staging/prod values go in the vault.
# ─────────────────────────────────────────────────────────────────────────────

# ─── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000

# ─── API Gateway (:8080) ──────────────────────────────────────────────────────
APP_GATEWAY_PORT=8080
APP_GATEWAY_RATE_LIMIT_MAX=100
APP_GATEWAY_RATE_LIMIT_WINDOW_MS=60000

# ─── Auth Service (:8081) ─────────────────────────────────────────────────────
APP_AUTH_PORT=8081
APP_AUTH_DATABASE_URL=postgresql://dev:dev@localhost:5432/auth_db
APP_AUTH_REDIS_URL=redis://localhost:6379
APP_AUTH_BCRYPT_ROUNDS=10

# JWT — RS256: generate with `openssl genrsa -out private.pem 2048`
# Locally you can use example values. In staging/prod they go in the vault.
APP_AUTH_JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n[REPLACE WITH PRIVATE KEY]\n-----END RSA PRIVATE KEY-----"
APP_AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n[REPLACE WITH PUBLIC KEY]\n-----END PUBLIC KEY-----"
APP_AUTH_JWT_EXPIRY=3600
APP_AUTH_REFRESH_TOKEN_EXPIRY=604800

# ─── [Service Name N] (:[port]) ───────────────────────────────────────────────
# APP_[SERVICE]_PORT=[port]
# APP_[SERVICE]_DATABASE_URL=postgresql://dev:dev@localhost:5432/[service]_db
# APP_[SERVICE]_[VARIABLE]=[local example value]

# ─── Shared database (if applicable) ─────────────────────────────────────────
# If each service has its own DB, comment this out and use the per-service variables
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD= (no password locally)

# ─── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=[project-name]

# ─── External services (local stubs) ─────────────────────────────────────────
# Replace with stub/mock URLs for local development
# APP_[EXTERNAL_SERVICE]_URL=http://localhost:[stub_port]
# APP_[EXTERNAL_SERVICE]_API_KEY=dev-key-only-local
